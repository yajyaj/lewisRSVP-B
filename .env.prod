
APP_NAME="Gather RSVP"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:YOUR_NEW_PRODUCTION_KEY
APP_URL=https://YOUR-BACKEND.koyeb.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=YOUR_AIVEN_HOST
DB_PORT=YOUR_AIVEN_PORT
DB_DATABASE=YOUR_AIVEN_DATABASE
DB_USERNAME=YOUR_AIVEN_USERNAME
DB_PASSWORD=YOUR_AIVEN_PASSWORD

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=https://lewisrsvp-f.jayofficial17.workers.dev
CORS_ALLOWED_ORIGINS=https://lewisrsvp-f.jayofficial17.workers.dev
SANCTUM_STATEFUL_DOMAINS=lewisrsvp-f.jayofficial17.workers.dev
